<!DOCTYPE html>
<!-- By Ion-o-koji -->
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Copy Button v1</title>
  <style>
    body {
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Arial;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
      background: linear-gradient(180deg, #021021 0%, #041426 100%);
    }

    button {
      background: #06b6d4;
      border: 0;
      color: #012;
      padding: 8px 12px;
      border-radius: 9px;
      cursor: pointer;
      font-weight: 700;
    }

    button:hover {
      opacity: 0.9;
    }

  </style>
</head>

<body>
  <button id="copyBtn">Copy</button>

  <script>
    const copyBtn = document.getElementById('copyBtn');
    const textToCopy = 'Your text here';

    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(textToCopy);
        copyBtn.textContent = 'Copied';
        setTimeout(() => copyBtn.textContent = 'Copy', 1200);
      } catch (e) {
        const ta = document.createElement('textarea');
        ta.value = textToCopy;
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand('copy');
          copyBtn.textContent = 'Copied';
        } catch (e2) {
          alert('Copy failed');
        }
        ta.remove();
        setTimeout(() => copyBtn.textContent = 'Copy', 1200);
      }
    });

    (() => {
      const ENTRY = 'Copy Button v1',
        KEY = 'Ion-o-koji Watermark';
      const logs = (localStorage.getItem(KEY) || "").split('\n').map(line => line.replace(/^- /, '').trim()).filter(line => line && line !== ENTRY);
      logs.push(ENTRY);
      localStorage.setItem(KEY, logs.map(item => `- ${item}`).join('\n'));
    })();

  </script>
</body>

</html>
